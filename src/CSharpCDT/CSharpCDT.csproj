<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CDT</RootNamespace>
    <!-- LibraryImport's generated marshalling is unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>C# bindings for Artem Ogre's CDT, constrained Delaunay triangulation, as PythonCDT is for Python.</Description>
  </PropertyGroup>

  <!-- The NuGet package. -->
  <PropertyGroup>
    <PackageId>CSharpCDT</PackageId>
    <Authors>Aidan Newsome</Authors>
    <Copyright>CDT © Artem Ogre</Copyright>
    <PackageReleaseNotes>https://github.com/aidannewsome/CSharpCDT/releases/tag/$(Version)</PackageReleaseNotes>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/aidannewsome/CSharpCDT</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aidannewsome/CSharpCDT</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>delaunay;triangulation;constrained;cdt;mesh;geometry</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CSharpCDT.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <!-- CDT bundles code under two more licences, which go with it. -->
    <None
      Include="..\..\CDT\CDT\LICENSE-LLVM.txt;..\..\CDT\CDT\LICENSE-predicates.txt"
      Pack="true"
      PackagePath="licenses/"
      Visible="false"
    />
  </ItemGroup>

  <!-- The native library, src/cdt_c, built with CMake before the C# and copied beside it, and so
       beside every project that references this one. It is also staged under
       artifacts/runtimes/<platform>/native, the layout NuGet expects, and everything staged there is
       packed: on a machine, its own platform, and in the release workflow, all of them. -->
  <PropertyGroup>
    <NativeDir>$(MSBuildThisFileDirectory)..\cdt_c</NativeDir>
    <NativeBuildDir>$(NativeDir)\build</NativeBuildDir>
    <RuntimesDir>$(MSBuildThisFileDirectory)..\..\artifacts\runtimes\</RuntimesDir>
    <NativeRid Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</NativeRid>
    <NativeRid Condition="$([MSBuild]::IsOSPlatform('Windows'))"
      >win-$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</NativeRid>
    <NativeRid Condition="$([MSBuild]::IsOSPlatform('Linux'))"
      >linux-$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</NativeRid>
  </PropertyGroup>
  <Target Name="BuildNative" BeforeTargets="BeforeBuild">
    <Exec
      Command="cmake -S &quot;$(NativeDir)&quot; -B &quot;$(NativeBuildDir)&quot; -DCMAKE_BUILD_TYPE=Release"
      StandardOutputImportance="low"
    />
    <Exec
      Command="cmake --build &quot;$(NativeBuildDir)&quot; --config Release"
      StandardOutputImportance="low"
    />
    <ItemGroup>
      <NativeLibrary
        Include="$(NativeBuildDir)\bin\*cdt_c.*"
        Exclude="$(NativeBuildDir)\bin\*.exp;$(NativeBuildDir)\bin\*.lib;$(NativeBuildDir)\bin\*.pdb"
      />
      <None
        Include="@(NativeLibrary)"
        CopyToOutputDirectory="PreserveNewest"
        Link="%(Filename)%(Extension)"
      />
    </ItemGroup>
    <Copy
      SourceFiles="@(NativeLibrary)"
      DestinationFolder="$(RuntimesDir)$(NativeRid)\native"
      SkipUnchangedFiles="true"
    />
  </Target>
  <Target Name="PackNative" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <StagedNative
        Include="$(RuntimesDir)**\*"
        Pack="true"
        PackagePath="runtimes/%(RecursiveDir)"
        Visible="false"
      />
      <None Include="@(StagedNative)" />
    </ItemGroup>
  </Target>
</Project>
